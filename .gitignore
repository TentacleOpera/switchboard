# Dependencies
node_modules/
yarn.lock
package-lock.json

# Build output
out/
dist/

# Packaged extensions
*.vsix

# Release staging folder (prebuilt .vsix artifacts; ignored to keep release assets out of git history)
releases/

# Local env / secrets — never commit
.env
.env.*

# TypeScript cache
*.tsbuildinfo

# IDE
.idea/

# OS files
.DS_Store
Icon
Thumbs.db

# Test output
.vscode-test/

# Editor settings are per-machine. extensions/launch/tasks/mcp stay committed —
# they are shared project config. settings.json is where VS Code writes whatever
# a user changes through the Settings UI, including absolute paths, and it was
# carrying a Windows brain path on a macOS checkout. It also seeded
# switchboard.workspace.ignoreStrategy/ignoreRules to fresh clones, which
# git-ignore-custom-default-regression.test.js exists to forbid.
.vscode/settings.json

# Logs
*.log
npm-debug.log*

# Temp/patch files
*.patch
*.tmp
diff_output.txt
list_output.txt

# Test artifacts (generated by test suite)
.test-workspace/
.tmp-codex-home/

.web-ai/

# >>> Switchboard managed exclusions >>>
# Switchboard runtime state (per-session, not shareable)
.switchboard/*
!.switchboard/reviews/
!.switchboard/plans/
!.switchboard/features/

# Agent and CLI control-plane definitions (projected, gitignored)
.agents/
.claude/

# Notion page content cache
.switchboard/notion-cache.md

# Stray/backup SQLite databases — never commit these if accidentally created
.switchboard/**/*.db
.switchboard/**/*.db-shm
.switchboard/**/*.db-wal
.switchboard/**/*.bak

# Encrypted secret store and its master key. The live store is machine-global
# (~/.switchboard) but legacy per-workspace stores — plus the .migrated.bak and
# .corrupt-*.bak renames migration leaves behind — can still sit in a workspace.
# Named explicitly rather than relying on the .switchboard/* glob above: these
# are credentials, and a fork that drops the glob must still never commit them.
.switchboard/secrets.enc*
.switchboard/.master-key*

# Transfer bundle — personal-portable settings (theme, thresholds, prompt
# overrides) for handing a workspace to ANOTHER machine. The default export
# path is ~/.switchboard/transfer/ (outside the repo), but a bundle placed in
# the tree must stay ignored: it carries one person's chrome, not team-shared
# state, and committing it imposes one machine's settings on every clone.
switchboard-transfer*.json
# <<< Switchboard managed exclusions <<<

# Generated vendor assets for browser panels (xterm.js et al).
# node_modules is the single source of truth; `npm run vendor:sync` (invoked by
# compile/watch/pretest) writes both src/webview/vendor and dist/webview/vendor.
# Never commit these — a checked-in copy silently rots when the dep is bumped.
src/webview/vendor/
