#!/bin/sh
# npm `bin` entry for the standalone host.
#
# WHY THIS EXISTS: `--max-old-space-size` is applied by the Go front controller
# (cmd/switchboard/main.go) and the Go launcher (internal/launcher/discovery.go),
# and the .deb puts that controller on PATH. An npm/npx install does not — its
# PATH entry came from package.json's `bin`, which pointed straight at the
# bundle, so the board ran on V8's auto-sized ceiling. On a 1 GB box that
# ceiling lands BELOW the board's working set and the host aborts with RAM to
# spare. This shim closes that gap for every npm-installed launch.
#
# `exec` REPLACES this shell: no wrapper process survives. That is the whole
# reason this is sh and not a re-exec inside cli.js, where the parent would
# linger holding the 18 MB bundle (~40 MB RSS) on the device we are sizing for.
#
# Not NODE_OPTIONS: it leaks into every child process, including the Go pty
# host. Not v8.setFlagsFromString: a measured silent no-op — V8 parses this
# flag once, at startup, before this file could run.
set -e

# Resolve through npm's bin symlink to this file's real directory.
target=$0
while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
        /*) target=$link ;;
        *)  target=$(dirname "$target")/$link ;;
    esac
done
dir=$(cd "$(dirname "$target")" && pwd)

# Same default (800 MB budget - 300 MB non-heap - 190 MB offset = 310 MB)
# and same override the other paths use, so all agree.
mb=${SWITCHBOARD_MAX_OLD_SPACE_MB:-310}
case $mb in
    ''|*[!0-9]*)
        echo "switchboard: SWITCHBOARD_MAX_OLD_SPACE_MB must be an integer, got '$mb'" >&2
        exit 64
        ;;
esac

exec node "--max-old-space-size=$mb" "$dir/../dist/standalone/cli.js" "$@"
