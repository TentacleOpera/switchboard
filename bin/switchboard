#!/bin/sh
# npm `bin` entry for the standalone host.
#
# This shim exists ONLY to resolve npm's bin symlink and exec the bundle.
# It sets NO memory ceiling.
#
# HISTORY, so nobody adds one back: on 2026-09-14 this shim hardcoded
# `--max-old-space-size` (512, later 310). Both values were derived from a
# board-only Pi estimate and were far below the real working peak. The result
# on an ordinary host was a fatal abort mid-run:
#
#   pid 653387, 3.7 GB host: Mark-Compact 517.0 -> 516.4 MB
#   FATAL ERROR: Reached heap limit Allocation failed - JavaScript heap out of
#   memory  (inside better_sqlite3 Statement::JS_all, i.e. a board read)
#
# The flag's only legitimate use is to RAISE V8's auto-sized ceiling on a host
# so small that the automatic limit falls below the board's working set. On any
# host where the automatic limit is already adequate, setting it can only lower
# it -- it adds a kill condition and buys nothing. A default value cannot know
# which case it is in, so there is no safe default and none is set here.
#
# If a specific device genuinely needs a raised ceiling, set it explicitly on
# that device, at a measured value:
#   SWITCHBOARD_MAX_OLD_SPACE_MB=<measured> switchboard tailnet
set -e

# Resolve through npm's bin symlink to this file's real directory.
target=$0
while [ -L "$target" ]; do
    link=$(readlink "$target")
    case $link in
        /*) target=$link ;;
        *)  target=$(dirname "$target")/$link ;;
    esac
done
dir=$(cd "$(dirname "$target")" && pwd)

exec node "$dir/../dist/standalone/cli.js" "$@"
