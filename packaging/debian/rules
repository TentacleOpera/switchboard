#!/usr/bin/make -f
# debian/rules: build the .deb package.
# The package vendors node_modules built for arm64 at package-build time,
# so no target Pi ever needs a compiler. See raspberry-pi-installs-switchboard-with-apt.md.

export DH_VERBOSE=1

%:
	dh $@

# Do NOT enable or start the service on install — the package installs
# disabled. `switchboard setup host` enables it after collecting a workspace.
override_dh_installsystemd:
	dh_installsystemd --no-start --no-enable

# The package carries its own vendored node_modules — no dh_nodejs.
override_dh_auto_build:

override_dh_auto_install:
	# Install the built dist/ and bin/ under /usr/lib/switchboard
	install -d $(CURDIR)/debian/switchboard/usr/lib/switchboard
	cp -a dist/* $(CURDIR)/debian/switchboard/usr/lib/switchboard/
	cp -a node_modules $(CURDIR)/debian/switchboard/usr/lib/switchboard/node_modules
	# Entry point symlink
	install -d $(CURDIR)/debian/switchboard/usr/bin
	ln -s /usr/lib/switchboard/standalone/cli.js $(CURDIR)/debian/switchboard/usr/bin/switchboard
	# Config file
	install -d $(CURDIR)/debian/switchboard/etc/switchboard
	install -m 0644 debian/switchboard.env $(CURDIR)/debian/switchboard/etc/switchboard/switchboard.env
	# Mark as conffile
	echo "/etc/switchboard/switchboard.env" > $(CURDIR)/debian/switchboard/DEBIAN/conffiles

# Verify native modules are present and loadable before the package is built.
# node-pty is optional in npm — its absence is silent all the way to a user
# whose terminals do not work. Make it loud at build time.
override_dh_auto_test:
	node -e "require('better-sqlite3')" || (echo "BUILD FAILED: better-sqlite3 not found in vendored node_modules" && exit 1)
	node -e "require('node-pty')" || (echo "BUILD FAILED: node-pty not found in vendored node_modules — terminals will not work" && exit 1)
