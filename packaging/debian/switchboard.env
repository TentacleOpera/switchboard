# Switchboard service configuration.
# This file is marked as a conffile — apt preserves operator edits across upgrades.
# Edit these values and run `switchboard setup host` to apply.

# The workspace root — the directory whose .switchboard/ holds the board.
SWITCHBOARD_WORKSPACE=

# The port the board serves on.
SWITCHBOARD_PORT=7777

# The serve mode: `local` for loopback only, `tailnet` for loopback plus
# Tailscale. Do NOT use `start` — it was removed and exits 1.
SWITCHBOARD_SERVE_MODE=tailnet

# The service user. Resolved by `switchboard setup host` from SUDO_USER
# or the current user. Never assume `pi`.
SWITCHBOARD_USER=

# Extra PATH entries for agent CLIs that live in per-user directories
# the package cannot know (e.g. ~/.local/bin, nvm paths).
SWITCHBOARD_EXTRA_PATH=
