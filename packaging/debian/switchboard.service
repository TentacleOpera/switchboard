[Unit]
Description=Switchboard standalone board server
After=network-online.target
After=tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# `-` prefix: a MISSING env file is non-fatal. The durable
# ~/.switchboard/host-settings.json is now the source of truth; the env file is
# a tagged legacy fallback, so an install configured only through the Host tab
# must still start (plan: settings-window-and-the-write-path-review-deleted).
EnvironmentFile=-/etc/switchboard/switchboard.env

# systemd expands ${VAR} in command lines ONLY. `User=`, `WorkingDirectory=`
# and `Environment=` take LITERAL values — a `${SWITCHBOARD_USER}` there is not
# substituted, it is a username spelled "${SWITCHBOARD_USER}" and the unit fails
# to start. So everything operator-specific that is NOT a command line is
# written by `switchboard setup host` into the drop-in
#   /etc/systemd/system/switchboard.service.d/10-setup.conf
# with resolved literal values (User=, WorkingDirectory=, Environment=HOME=,
# Environment=PATH=). This base unit carries only what is safe to interpolate.

# Refuse to start unconfigured rather than serving an empty or wrong tree.
# A board pointed at the wrong workspace is silent and wrong; a unit that
# exits with a named reason is loud. Also refuses the removed `start` verb
# and any serve mode that is not one of the two the CLI accepts.
#
# The legacy env file remains the tagged fallback for an install that has not
# yet been seeded with `switchboard setup host`. Once setup host seeds
# ~/.switchboard/host-settings.json, the durable document is the source of
# truth and the env values are only consulted as `legacy-env` fallbacks. Both
# paths must still validate here so an env-only configured install keeps
# starting (plan: settings-window-and-the-write-path-review-deleted).
#
# The durable document is checked FIRST. When $HOME/.switchboard/host-settings.json
# exists, `switchboard service` owns validation (it names the failing field and
# the store that answered) and these env checks must not veto a host that is
# configured entirely through the Host tab. Only an env-only install — one that
# has no durable document — is gated on the legacy variables here.
ExecStartPre=/bin/sh -c '\
  if [ -f "$HOME/.switchboard/host-settings.json" ]; then exit 0; fi; \
  if [ -z "$SWITCHBOARD_WORKSPACE" ]; then \
    echo "SWITCHBOARD_WORKSPACE is empty in /etc/switchboard/switchboard.env - run: sudo switchboard setup host" >&2; exit 1; \
  fi; \
  if [ ! -d "$SWITCHBOARD_WORKSPACE" ]; then \
    echo "SWITCHBOARD_WORKSPACE=$SWITCHBOARD_WORKSPACE is not a directory - run: sudo switchboard setup host" >&2; exit 1; \
  fi; \
  case "$SWITCHBOARD_SERVE_MODE" in \
    local|tailnet) ;; \
    *) echo "SWITCHBOARD_SERVE_MODE=$SWITCHBOARD_SERVE_MODE is not local or tailnet (start was removed) - run: sudo switchboard setup host" >&2; exit 1 ;; \
  esac'

# ExecStart runs the service entrypoint with NO per-field flags. The
# EnvironmentFile still exports SWITCHBOARD_PORT/SWITCHBOARD_WORKSPACE/
# SWITCHBOARD_SERVE_MODE/SWITCHBOARD_EXTRA_PATH into the process environment;
# the service subcommand reads those as `legacy-env` fallbacks (see cli.ts
# isServiceCommand block). Passing them again as --port/--workspace would tag
# them `cli-flag`, which always beats durable — so a port or workspace saved
# via the Host tab would never take effect on service restart. Leaving them
# off the command line is what lets a saved durable value win when present and
# the env value fill the gap when the durable file is absent (a fresh install
# that has not yet run `switchboard setup host`). An explicit --serve-mode is
# intentionally omitted for the same reason: a saved durable serveMode takes
# effect, with the env SERVE_MODE as the fallback.
# See settings-window-and-the-write-path-review-deleted.md.
ExecStart=/usr/bin/switchboard service --no-open

Restart=on-failure
RestartSec=5

# switchboard stop frees the port and logs "Server stopped" without the
# process always exiting — without a stop timeout, a restart hangs and a
# reboot the operator is counting on does not complete.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
