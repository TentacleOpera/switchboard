[Desktop Entry]
Type=Application
Name=Switchboard
GenericName=Agent Fleet Command
Comment=Plan-driven agent orchestration board
# The launcher is the static Go binary that can run before Node.js or
# Switchboard is installed. It resolves the workspace from the session's
# default working directory (Path= is deliberately absent so the entry does
# not pin a tree the package cannot know), supervises the standalone host,
# and opens the board. The previous `switchboard local` entry was
# cwd-sensitive and could serve $HOME on icon launch; the launcher passes
# --workspace-root explicitly so the host does not infer the workspace from
# cwd (plan: go-launcher-static-binary).
Exec=switchboard-launcher start
Icon=switchboard
Terminal=false
Categories=Development;Utility;
StartupNotify=true
